# lib/unicore/mktables writes "Autogenerated starting on <time> (<localtime>)" into mktables.lst; use SOURCE_DATE_EPOCH, in UTC.
post_src_prepare() {
	[[ -n ${SOURCE_DATE_EPOCH} ]] || die "SOURCE_DATE_EPOCH is not set"
	local mk="${S}/lib/unicore/mktables"
	sed -i -e 's|^\(    \$start_time= \)time;|\1$ENV{SOURCE_DATE_EPOCH} \|\| time;|' \
		-e 's|my \$localtime = localtime \$start_time;|my $localtime = gmtime $start_time;|' "${mk}" || die
	grep -q 'ENV{SOURCE_DATE_EPOCH}' "${mk}" && grep -q 'gmtime \$start_time' "${mk}" || die "perl: mktables not patched"
}
